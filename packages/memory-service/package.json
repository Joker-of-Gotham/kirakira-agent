{
  "name": "@kirakira/memory-service",
  "version": "0.1.0",
  "description": "Kirakira MemoryService orchestration — retain, recall, reflect, checkpoint, governance",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
