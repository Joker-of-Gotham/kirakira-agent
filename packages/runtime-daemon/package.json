{
  "name": "@kirakira/runtime-daemon",
  "version": "0.1.0",
  "description": "Local runtime daemon for Kirakira agent orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kirakira-runtime-daemon": "./dist/bin/kirakira-runtime-daemon.js"
  },
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/kirakira-runtime-daemon.ts --format esm --dts --clean",
    "start": "node ./dist/bin/kirakira-runtime-daemon.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kirakira/core": "workspace:*",
    "@kirakira/config-resolver": "workspace:*",
    "@kirakira/agent-runtime": "workspace:*",
    "@kirakira/deep-research": "workspace:*",
    "@kirakira/event-store": "workspace:*",
    "@kirakira/memory-service": "workspace:*",
    "@kirakira/memory-store": "workspace:*",
    "@kirakira/mcp-adapter": "workspace:*",
    "@kirakira/orchestrator-kernel": "workspace:*",
    "@kirakira/policy-engine": "workspace:*",
    "@kirakira/runtime-contracts": "workspace:*",
    "@kirakira/skill-runtime": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "ulid": "^2.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "typescript": "^5.8.3",
    "tsup": "^8.4.0"
  }
}
