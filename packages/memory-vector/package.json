{
  "name": "@kirakira/memory-vector",
  "version": "0.1.0",
  "description": "Kirakira memory vector storage (Qdrant + pgvector)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    },
    "./qdrant/*": {
      "types": "./dist/qdrant/*.d.ts",
      "import": "./dist/qdrant/*.js"
    },
    "./pgvector/*": {
      "types": "./dist/pgvector/*.d.ts",
      "import": "./dist/pgvector/*.js"
    },
    "./embedding/*": {
      "types": "./dist/embedding/*.d.ts",
      "import": "./dist/embedding/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kirakira/core": "workspace:*",
    "@kirakira/memory-core": "workspace:*",
    "@qdrant/js-client-rest": "^1.13.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
