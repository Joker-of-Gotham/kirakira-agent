{
  "name": "@kirakira/cli",
  "version": "0.1.0",
  "description": "Kirakira Agent CLI - command-line interface",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kirakira-agent": "./bin/run.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kirakira/audit-ledger": "workspace:*",
    "@kirakira/config-resolver": "workspace:*",
    "@kirakira/core": "workspace:*",
    "@kirakira/mcp-adapter": "workspace:*",
    "@kirakira/policy-engine": "workspace:*",
    "@kirakira/registry-client": "workspace:*",
    "@kirakira/skill-runtime": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4.7.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "chalk": "^5.4.0",
    "chokidar": "^4.0.0",
    "execa": "^9.5.0",
    "fast-glob": "^3.3.0",
    "ink": "^7.0.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19",
    "smol-toml": "^1.3.0",
    "wrap-ansi": "^10.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "oclif": {
    "bin": "kirakira-agent",
    "dirname": "kirakira-agent",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topicSeparator": " "
  }
}
