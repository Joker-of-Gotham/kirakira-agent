{
  "name": "@kirakira/memory-store",
  "version": "0.1.0",
  "description": "Postgres, Redis, and S3 persistence for Kirakira memory services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres/*": {
      "types": "./dist/postgres/*.d.ts",
      "import": "./dist/postgres/*.js"
    },
    "./redis/*": {
      "types": "./dist/redis/*.d.ts",
      "import": "./dist/redis/*.js"
    },
    "./blob/*": {
      "types": "./dist/blob/*.d.ts",
      "import": "./dist/blob/*.js"
    },
    "./outbox/*": {
      "types": "./dist/outbox/*.d.ts",
      "import": "./dist/outbox/*.js"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@kirakira/core": "workspace:*",
    "@kirakira/event-store": "workspace:*",
    "@kirakira/memory-core": "workspace:*",
    "ioredis": "^5.6.0",
    "postgres": "^3.4.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
