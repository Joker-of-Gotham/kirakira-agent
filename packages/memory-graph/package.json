{
  "name": "@kirakira/memory-graph",
  "version": "0.1.0",
  "description": "Kirakira memory graph adapters (Neo4j, Kuzu)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kirakira/core": "workspace:*",
    "@kirakira/memory-core": "workspace:*",
    "kuzu": "^0.11.3",
    "neo4j-driver": "^5.28.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
