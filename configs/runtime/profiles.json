{
  "schemaVersion": 1,
  "defaultProfile": "container",
  "envBindings": {
    "services": {
      "kirakirad": "KIRAKIRA_PDP_ENDPOINT",
      "postgres": "DATABASE_URL",
      "redis": "REDIS_URL",
      "qdrant": "QDRANT_URL",
      "neo4j": "NEO4J_URI",
      "minio": "S3_ENDPOINT"
    },
    "values": {
      "daemon.socketPath": {
        "env": "KIRAKIRA_DAEMON_SOCKET",
        "resolve": "daemonSocketPath"
      },
      "daemon.eventStorePath": "KIRAKIRA_EVENT_STORE_PATH",
      "daemon.browserGateway.host": "KIRAKIRA_BROWSER_GATEWAY_HOST",
      "daemon.browserGateway.port": "KIRAKIRA_BROWSER_GATEWAY_PORT",
      "daemon.browserGateway.path": "KIRAKIRA_BROWSER_GATEWAY_PATH",
      "daemon.browserGateway.token": [
        "KIRAKIRA_BROWSER_GATEWAY_TOKEN",
        "VITE_KIRAKIRA_GATEWAY_TOKEN"
      ],
      "presentation.web.url": "KIRAKIRA_WEB_URL",
      "presentation.desktop.rendererUrl": [
        "KIRAKIRA_DESKTOP_RENDERER_URL",
        "KIRAKIRA_DESKTOP_DEV_URL"
      ],
      "memory.vector.backend": "KIRAKIRA_MEMORY_VECTOR_BACKEND",
      "memory.graph.backend": "KIRAKIRA_MEMORY_GRAPH_BACKEND",
      "memory.graph.database": "KIRAKIRA_MEMORY_KUZU_PATH",
      "memory.blob.bucket": [
        "KIRAKIRA_MEMORY_S3_BUCKET",
        "S3_BUCKET"
      ],
      "memory.blob.region": "KIRAKIRA_MEMORY_S3_REGION",
      "memory.embedding.model": "KIRAKIRA_MEMORY_EMBEDDING_MODEL",
      "memory.recall.tokenBudget": "KIRAKIRA_MEMORY_RECALL_TOKEN_BUDGET",
      "memory.recall.limit": "KIRAKIRA_MEMORY_RECALL_LIMIT",
      "memory.recall.level": "KIRAKIRA_MEMORY_RECALL_LEVEL"
    },
    "booleans": {
      "daemon.browserGateway.enabled": {
        "env": "KIRAKIRA_BROWSER_GATEWAY_ENABLED",
        "true": "1",
        "false": "0"
      }
    },
    "joined": {
      "daemon.browserGateway.allowedOrigins": {
        "env": "KIRAKIRA_BROWSER_GATEWAY_ALLOWED_ORIGINS",
        "separator": ","
      }
    },
    "computed": {
      "browserGatewayEndpoint": {
        "source": "daemon.browserGateway",
        "urlEnv": "VITE_KIRAKIRA_GATEWAY_URL",
        "modeEnv": "VITE_KIRAKIRA_RUNTIME_MODE",
        "mode": "gateway"
      }
    }
  },
  "serviceBindings": {
    "kirakirad": {
      "scheme": "tcp",
      "host": "kirakirad"
    },
    "postgres": {
      "scheme": "postgres",
      "host": "postgres",
      "username": {
        "env": "KIRAKIRA_POSTGRES_USER",
        "default": "kirakira"
      },
      "password": {
        "env": "KIRAKIRA_POSTGRES_PASSWORD",
        "default": "kirakira"
      },
      "database": {
        "env": "KIRAKIRA_POSTGRES_DB",
        "default": "kirakira"
      },
      "authInUrl": true
    },
    "redis": {
      "scheme": "redis",
      "host": "redis"
    },
    "qdrant": {
      "scheme": "http",
      "host": "qdrant"
    },
    "neo4j": {
      "scheme": "bolt",
      "host": "neo4j",
      "username": {
        "env": "KIRAKIRA_NEO4J_USER",
        "default": "neo4j"
      },
      "password": {
        "env": "KIRAKIRA_NEO4J_PASSWORD",
        "default": "testpassword"
      }
    },
    "minio": {
      "scheme": "http",
      "host": "minio",
      "username": {
        "env": ["KIRAKIRA_MINIO_ROOT_USER", "S3_ACCESS_KEY_ID"],
        "default": "minioadmin"
      },
      "password": {
        "env": ["KIRAKIRA_MINIO_ROOT_PASSWORD", "S3_SECRET_ACCESS_KEY"],
        "default": "minioadmin"
      }
    }
  },
  "serviceCatalog": {
    "groups": {
      "memory-stack": ["postgres", "redis", "qdrant", "neo4j", "minio"],
      "runtime-stack": ["postgres", "redis", "qdrant", "neo4j", "minio", "kirakirad"]
    },
    "services": {
      "kirakirad": {
        "composeService": "kirakirad",
        "primaryPort": "pdp",
        "ports": {
          "health": {
            "target": 8181,
            "env": "KIRAKIRA_KIRAKIRAD_HEALTH_PORT",
            "default": 8181
          },
          "pdp": {
            "target": 17777,
            "env": "KIRAKIRA_KIRAKIRAD_PDP_PORT",
            "default": 17777
          }
        }
      },
      "postgres": {
        "composeService": "postgres",
        "primaryPort": "postgres",
        "ports": {
          "postgres": {
            "target": 5432,
            "env": "KIRAKIRA_POSTGRES_PORT",
            "default": 5432
          }
        }
      },
      "redis": {
        "composeService": "redis",
        "primaryPort": "redis",
        "ports": {
          "redis": {
            "target": 6379,
            "env": "KIRAKIRA_REDIS_PORT",
            "default": 6379
          }
        }
      },
      "qdrant": {
        "composeService": "qdrant",
        "primaryPort": "http",
        "ports": {
          "http": {
            "target": 6333,
            "env": "KIRAKIRA_QDRANT_HTTP_PORT",
            "default": 6333
          },
          "grpc": {
            "target": 6334,
            "env": "KIRAKIRA_QDRANT_GRPC_PORT",
            "default": 6334
          }
        }
      },
      "neo4j": {
        "composeService": "neo4j",
        "primaryPort": "bolt",
        "ports": {
          "bolt": {
            "target": 7687,
            "env": "KIRAKIRA_NEO4J_BOLT_PORT",
            "default": 7687
          },
          "http": {
            "target": 7474,
            "env": "KIRAKIRA_NEO4J_HTTP_PORT",
            "default": 7474
          }
        }
      },
      "minio": {
        "composeService": "minio",
        "primaryPort": "api",
        "ports": {
          "api": {
            "target": 9000,
            "env": "KIRAKIRA_MINIO_API_PORT",
            "default": 9000
          },
          "console": {
            "target": 9001,
            "env": "KIRAKIRA_MINIO_CONSOLE_PORT",
            "default": 9001
          }
        }
      }
    }
  },
  "memory": {
    "enabled": true,
    "serviceGroups": ["memory-stack"],
    "vector": {
      "backend": "qdrant",
      "urlEnv": "QDRANT_URL",
      "apiKeyEnv": "QDRANT_API_KEY",
      "collection": "kirakira_memory"
    },
    "graph": {
      "backend": "neo4j",
      "uriEnv": "NEO4J_URI",
      "usernameEnv": "KIRAKIRA_NEO4J_USER",
      "passwordEnv": "KIRAKIRA_NEO4J_PASSWORD"
    },
    "blob": {
      "backend": "s3",
      "endpointEnv": "S3_ENDPOINT",
      "bucket": "kirakira-memory",
      "region": "us-east-1",
      "accessKeyIdEnv": "S3_ACCESS_KEY_ID",
      "secretAccessKeyEnv": "S3_SECRET_ACCESS_KEY"
    },
    "embedding": {
      "model": "text-embedding-3-small",
      "apiKeyEnv": "OPENAI_API_KEY",
      "baseUrlEnv": "OPENAI_BASE_URL"
    },
    "recall": {
      "tokenBudget": 4096,
      "limit": 8,
      "level": "L3"
    }
  },
  "deepResearch": {
    "mcp": {
      "defaultTargetGroups": ["workspace-readonly"],
      "groups": {
        "workspace-readonly": ["workspace-search"]
      },
      "targets": {
        "workspace-search": {
          "server": "filesystem-search",
          "tool": "search",
          "title": "Workspace search evidence",
          "metadata": {
            "source": "runtime-profile",
            "riskLevel": "low",
            "readOnly": true
          }
        }
      },
      "includeErrorEvidence": true,
      "maxEvidence": 4
    }
  },
  "daemonCompositionGates": {
    "runtime-daemon:composition-smoke": {
      "description": "Single KernelBridge smoke proving subagent topology, deep research MCP, MCP policy/trust/audit/OTel, memory recall, checkpoint persistence, and profile readiness in one daemon run.",
      "profile": "workbench-host",
      "liveEnv": "KIRAKIRA_RUNTIME_DAEMON_COMPOSITION_SMOKE_LIVE",
      "passedEnv": "KIRAKIRA_RUNTIME_DAEMON_COMPOSITION_SMOKE_PASSED",
      "resultPath": "docs/upgrade/gates/runtime-daemon-composition-smoke.json",
      "checks": [
        "runtime-daemon:kernelbridge-single-run",
        "runtime-daemon:subagent-topology-events",
        "runtime-daemon:deep-research-mcp-source",
        "runtime-daemon:mcp-policy-trust-audit-otel",
        "runtime-daemon:memory-recall-events",
        "runtime-daemon:checkpoint-persistence",
        "runtime-daemon:profile-readiness-manifest"
      ],
      "tests": [
        "test/smoke/runtime-daemon/composition-smoke.test.ts"
      ]
    }
  },
  "presentationHydratedVisualQaGates": {
    "presentation-hydrated-visual-qa": {
      "description": "Profile-owned hydrated visual QA gate opening real web and desktop renderer targets, capturing screenshots, checking console/page errors, overflow, nonblank rendering, and Runs/Agents/Research/Systems navigation.",
      "profile": "workbench-host",
      "workbenchSmokeGate": "presentation",
      "liveEnv": "KIRAKIRA_PRESENTATION_HYDRATED_VISUAL_QA_LIVE",
      "passedEnv": "KIRAKIRA_PRESENTATION_HYDRATED_VISUAL_QA_PASSED",
      "resultPath": "docs/upgrade/gates/presentation-hydrated-visual-qa.json",
      "screenshotDir": "docs/upgrade/gates/presentation-hydrated-visual-qa",
      "surfaces": ["web", "desktop"],
      "viewports": [
        { "id": "mobile", "width": 375, "height": 812 },
        { "id": "tablet", "width": 768, "height": 1024 },
        { "id": "desktop", "width": 1440, "height": 900 }
      ],
      "views": [
        {
          "id": "runs",
          "label": "Runs",
          "navAriaLabel": "Show run operations workspace",
          "selector": "workbench-view-runs",
          "workspaceAriaLabel": "Run operations workspace"
        },
        {
          "id": "agents",
          "label": "Agents",
          "navAriaLabel": "Show agent swarm workspace",
          "selector": "workbench-view-agents",
          "workspaceAriaLabel": "Agent swarm workspace"
        },
        {
          "id": "research",
          "label": "Research",
          "navAriaLabel": "Show research evidence workspace",
          "selector": "workbench-view-research",
          "workspaceAriaLabel": "Research evidence workspace"
        },
        {
          "id": "systems",
          "label": "Systems",
          "navAriaLabel": "Show runtime systems workspace",
          "selector": "workbench-view-systems",
          "workspaceAriaLabel": "Memory, MCP, and artifact systems"
        }
      ],
      "checks": [
        "presentation:hydrated-web",
        "presentation:hydrated-desktop",
        "presentation:viewport-screenshots",
        "presentation:console-page-errors",
        "presentation:horizontal-overflow",
        "presentation:nonblank-rendering",
        "presentation:core-workbench-views"
      ]
    }
  },
  "integrationGates": {
    "upgrade": {
      "description": "Profile-owned fast integration gate spanning deep research, memory persistence, daemon composition, renderer-level workbench presentation, and renderer-only hydrated visual QA evidence.",
      "liveEnv": "KIRAKIRA_RUNTIME_INTEGRATION_GATE_LIVE",
      "passedEnv": "KIRAKIRA_RUNTIME_INTEGRATION_GATE_PASSED",
      "resultPath": "docs/upgrade/gates/runtime-integration-gate.json",
      "gates": [
        {
          "id": "deep-research:live-adapters",
          "kind": "deep-research-live-adapters",
          "profile": "workbench-host"
        },
        {
          "id": "memory-store:persistence",
          "kind": "memory-persistence",
          "profile": "test-host"
        },
        {
          "id": "runtime-daemon:composition-smoke",
          "kind": "runtime-daemon-composition",
          "profile": "workbench-host",
          "gate": "runtime-daemon:composition-smoke"
        },
        {
          "id": "workbench:presentation",
          "kind": "workbench-smoke",
          "profile": "workbench-host",
          "gate": "presentation"
        },
        {
          "id": "presentation:hydrated-visual-qa",
          "kind": "presentation-hydrated-visual-qa",
          "profile": "workbench-host",
          "gate": "presentation-hydrated-visual-qa",
          "skipInfra": true,
          "skipDaemon": true,
          "env": {
            "VITE_KIRAKIRA_RUNTIME_MODE": "mock"
          }
        }
      ]
    },
    "full-lifecycle": {
      "description": "Slow full lifecycle gate running Docker-backed services, daemon/gateway, web renderer, desktop renderer, Electron shell, and hydrated visual QA without renderer-only skips.",
      "liveEnv": "KIRAKIRA_RUNTIME_FULL_LIFECYCLE_INTEGRATION_LIVE",
      "passedEnv": "KIRAKIRA_RUNTIME_FULL_LIFECYCLE_INTEGRATION_PASSED",
      "resultPath": "docs/upgrade/gates/runtime-full-lifecycle-integration.json",
      "timeoutMs": 240000,
      "gates": [
        {
          "id": "deep-research:live-adapters",
          "kind": "deep-research-live-adapters",
          "profile": "workbench-host"
        },
        {
          "id": "memory-store:persistence",
          "kind": "memory-persistence",
          "profile": "test-host"
        },
        {
          "id": "runtime-daemon:composition-smoke",
          "kind": "runtime-daemon-composition",
          "profile": "workbench-host",
          "gate": "runtime-daemon:composition-smoke"
        },
        {
          "id": "workbench:presentation",
          "kind": "workbench-smoke",
          "profile": "workbench-host",
          "gate": "presentation"
        },
        {
          "id": "presentation:hydrated-visual-qa",
          "kind": "presentation-hydrated-visual-qa",
          "profile": "workbench-host",
          "gate": "presentation-hydrated-visual-qa",
          "env": {
            "VITE_KIRAKIRA_RUNTIME_MODE": "gateway"
          }
        }
      ]
    }
  },
  "runtimeLifecycleGates": {
    "runtime-full-lifecycle": {
      "description": "Top-level lifecycle proof for Docker services, daemon/browser gateway, web renderer, desktop renderer, Electron shell, and hydrated visual QA under one profile-owned live gate.",
      "profile": "workbench-host",
      "integrationGate": "full-lifecycle",
      "liveEnv": "KIRAKIRA_RUNTIME_FULL_LIFECYCLE_LIVE",
      "passedEnv": "KIRAKIRA_RUNTIME_FULL_LIFECYCLE_PASSED",
      "resultPath": "docs/upgrade/gates/runtime-full-lifecycle-gate.json",
      "timeoutMs": 240000,
      "requiredPreflights": ["docker compose"],
      "lifecycleSteps": [
        "runtime-ready:plan",
        "docker-compose:up-wait",
        "runtime-daemon:kernelbridge-composition",
        "workbench:web-gateway",
        "workbench:desktop-electron",
        "presentation:hydrated-visual-qa"
      ],
      "checks": [
        "runtime-lifecycle:docker-compose-ready",
        "runtime-lifecycle:daemon-gateway",
        "runtime-lifecycle:web-renderer",
        "runtime-lifecycle:desktop-renderer",
        "runtime-lifecycle:electron-shell",
        "runtime-lifecycle:hydrated-visual-qa"
      ],
      "references": [
        {
          "title": "Docker Compose up",
          "url": "https://docs.docker.com/reference/cli/docker/compose/up/"
        },
        {
          "title": "Node.js child_process",
          "url": "https://nodejs.org/api/child_process.html"
        },
        {
          "title": "Electron BrowserWindow",
          "url": "https://www.electronjs.org/docs/latest/api/browser-window"
        },
        {
          "title": "MCP lifecycle",
          "url": "https://modelcontextprotocol.io/specification/2025-11-25/basic/lifecycle"
        }
      ]
    }
  },
  "orchestration": {
    "topology": {
      "mode": "swarm",
      "defaultRole": "supervisor",
      "lanes": {
        "foreground": {
          "capacity": 2
        },
        "queued": {
          "capacity": 8
        },
        "background": {
          "capacity": 4
        },
        "delegated": {
          "capacity": 4
        }
      },
      "roles": [
        {
          "id": "supervisor",
          "description": "Owns planning, dependency ordering, handoff decisions, and final synthesis.",
          "lane": "foreground",
          "context": "filtered",
          "permissions": ["plan", "delegate", "synthesize"]
        },
        {
          "id": "researcher",
          "description": "Collects source-backed evidence with citation and memory recall obligations.",
          "lane": "background",
          "context": "filtered",
          "mcpServers": ["memory", "github"],
          "permissions": ["research", "cite", "recall"]
        },
        {
          "id": "implementer",
          "description": "Executes bounded code changes with explicit tool and MCP capability scope.",
          "lane": "delegated",
          "context": "isolated",
          "permissions": ["edit", "test", "artifact"]
        },
        {
          "id": "reviewer",
          "description": "Runs focused verification and reports regressions before merge or release.",
          "lane": "queued",
          "context": "filtered",
          "permissions": ["inspect", "test", "audit"]
        }
      ],
      "handoffs": [
        {
          "from": "supervisor",
          "to": "researcher",
          "mode": "tool",
          "inputFilter": "question-and-source-policy",
          "conditions": ["needs-current-evidence", "needs-citations"]
        },
        {
          "from": "supervisor",
          "to": "implementer",
          "mode": "tool",
          "inputFilter": "scoped-task-brief",
          "conditions": ["bounded-write-set", "parallelizable"]
        },
        {
          "from": "supervisor",
          "to": "reviewer",
          "mode": "tool",
          "inputFilter": "changed-files-and-validation-plan",
          "conditions": ["post-change-verification"]
        }
      ]
    }
  },
  "mcpCatalog": {
    "defaultServerGroups": ["default"],
    "groups": {
      "default": [
        "filesystem-core",
        "filesystem-search",
        "filesystem-git",
        "filesystem-patch",
        "filesystem-artifact",
        "memory",
        "github"
      ]
    },
    "servers": {
      "filesystem-core": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", { "value": "workspaceRoot" }],
        "env": {
          "NODE_NO_WARNINGS": "1"
        },
        "aliases": [
          { "alias": "fs.read_text", "tool": "read_file", "description": "Read a text file", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.read_many", "tool": "read_multiple_files", "description": "Read multiple files at once", "riskLevel": "medium", "readOnly": true },
          { "alias": "fs.list_dir", "tool": "list_directory", "description": "List directory contents", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.tree", "tool": "directory_tree", "description": "Recursive directory tree", "riskLevel": "medium", "readOnly": true },
          { "alias": "fs.info", "tool": "get_file_info", "description": "File metadata", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.search_name", "tool": "search_files", "description": "Search files by name pattern", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.allowed_dirs", "tool": "list_allowed_directories", "description": "List allowed directories", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.write", "tool": "write_file", "description": "Create or overwrite a file", "riskLevel": "high", "readOnly": false },
          { "alias": "fs.edit_preview", "tool": "edit_file", "description": "Preview file edit (dry-run)", "riskLevel": "medium", "readOnly": true },
          { "alias": "fs.edit_apply", "tool": "edit_file", "description": "Apply file edit", "riskLevel": "high", "readOnly": false },
          { "alias": "fs.mkdir", "tool": "create_directory", "description": "Create a directory", "riskLevel": "medium", "readOnly": false },
          { "alias": "fs.move", "tool": "move_file", "description": "Move or rename a file", "riskLevel": "high", "readOnly": false }
        ]
      },
      "filesystem-search": {
        "command": "npx",
        "args": ["-y", "mcp-ripgrep@latest"],
        "env": {
          "NODE_NO_WARNINGS": "1"
        },
        "aliases": [
          { "alias": "fs.grep", "tool": "search", "description": "Full-text search with ripgrep", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.grep_count", "tool": "count_matches", "description": "Count matches", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.list_by_type", "tool": "list_files", "description": "List files by type", "riskLevel": "low", "readOnly": true }
        ]
      },
      "filesystem-git": {
        "command": "npx",
        "args": ["-y", "@cyanheads/git-mcp-server"],
        "env": {
          "NODE_NO_WARNINGS": "1",
          "NODE_ENV": "production"
        },
        "aliases": [
          { "alias": "git.status", "tool": "git_status", "description": "Git status", "riskLevel": "low", "readOnly": true },
          { "alias": "git.diff", "tool": "git_diff", "description": "Git diff", "riskLevel": "low", "readOnly": true },
          { "alias": "git.log", "tool": "git_log", "description": "Git commit history", "riskLevel": "low", "readOnly": true },
          { "alias": "git.show", "tool": "git_show", "description": "Show Git object", "riskLevel": "low", "readOnly": true }
        ]
      },
      "filesystem-patch": {
        "command": "node",
        "args": [
          { "join": ["appRoot", "packages/mcp-filesystem-patch/dist/index.js"] },
          "--workspace",
          { "value": "workspaceRoot" }
        ],
        "aliases": [
          { "alias": "fs.snapshot", "tool": "snapshot_create", "description": "Create file snapshot", "riskLevel": "low", "readOnly": false },
          { "alias": "fs.snapshot_list", "tool": "snapshot_list", "description": "List snapshots", "riskLevel": "low", "readOnly": true },
          { "alias": "fs.patch_preview", "tool": "patch_preview", "description": "Preview patch application", "riskLevel": "medium", "readOnly": true },
          { "alias": "fs.patch_apply", "tool": "patch_apply", "description": "Apply patch", "riskLevel": "high", "readOnly": false },
          { "alias": "fs.rollback", "tool": "rollback", "description": "Rollback to snapshot", "riskLevel": "high", "readOnly": false },
          { "alias": "fs.diff_files", "tool": "diff_files", "description": "Diff two files", "riskLevel": "low", "readOnly": true }
        ]
      },
      "filesystem-artifact": {
        "command": "node",
        "args": [
          { "join": ["appRoot", "packages/mcp-filesystem-artifact/dist/index.js"] },
          "--workspace",
          { "value": "workspaceRoot" }
        ],
        "aliases": [
          { "alias": "artifact.put", "tool": "artifact_put", "description": "Store artifact", "riskLevel": "medium", "readOnly": false },
          { "alias": "artifact.summary", "tool": "artifact_get_summary", "description": "Get artifact summary", "riskLevel": "low", "readOnly": true },
          { "alias": "artifact.list", "tool": "artifact_list", "description": "List artifacts", "riskLevel": "low", "readOnly": true },
          { "alias": "artifact.hash", "tool": "content_hash", "description": "Hash file content", "riskLevel": "low", "readOnly": true },
          { "alias": "artifact.inspect", "tool": "inspect_binary", "description": "Inspect binary file type", "riskLevel": "low", "readOnly": true },
          { "alias": "artifact.preview", "tool": "preview_structured", "description": "Preview CSV/JSON data", "riskLevel": "low", "readOnly": true }
        ]
      },
      "memory": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-memory"],
        "env": {
          "NODE_NO_WARNINGS": "1"
        }
      },
      "github": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "NODE_NO_WARNINGS": "1"
        }
      }
    }
  },
  "profiles": {
    "container": {
      "mode": "container",
      "workspaceRoot": "/workspace",
      "appRoot": "/app",
      "composeFiles": ["docker-compose.yml"],
      "composeProfiles": ["cli"],
      "envFiles": [".env"],
      "serviceEndpointGroups": ["runtime-stack"],
      "mcp": {
        "workspaceRoot": "/workspace",
        "appRoot": "/app"
      },
      "containerStartup": {
        "runtimeImage": "kirakira-agent-runtime:local",
        "sourceHashLabel": "org.kirakira.source-hash",
        "sourceHashCachePath": ".kirakira/runtime-image.hash",
        "workspaceBuildCachePath": ".kirakira/workspace-build.hash",
        "buildService": "kirakira-agent",
        "runService": "kirakira-agent",
        "runtimeServiceGroups": ["runtime-stack"],
        "defaultCommand": ["chat"],
        "interactiveCommands": ["chat"],
        "runOptions": ["--rm", "--no-deps", "--pull", "never"],
        "hashRoots": [
          ".dockerignore",
          "Dockerfile",
          "configs/runtime/profiles.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          "turbo.json",
          "tsconfig.base.json",
          "vitest.config.ts",
          "pytest.ini",
          "packages",
          "scripts"
        ],
        "ignoredHashDirs": [".git", ".turbo", "coverage", "dist", "node_modules"],
        "ignoredHashFiles": ["scripts/kirakira.mjs"],
        "workspaceBuild": {
          "distEntry": "packages/cli/dist/index.js",
          "filter": "@kirakira/cli..."
        },
        "overlay": {
          "packagesRoot": "packages",
          "containerPackagesRoot": "/app/packages",
          "scripts": ["kirakira-container.mjs", "kirakira-common.mjs", "runtime-profile.mjs"],
          "containerScriptsRoot": "/app/scripts",
          "files": [
            {
              "source": "configs/runtime/profiles.json",
              "target": "/app/configs/runtime/profiles.json"
            }
          ]
        }
      }
    },
    "host": {
      "mode": "host",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": [],
      "composeProfiles": [],
      "envFiles": [".env"],
      "serviceEndpointMode": "published",
      "serviceEndpointGroups": ["runtime-stack"],
      "serviceEndpointDefaults": {
        "host": "127.0.0.1"
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "workbench-host": {
      "mode": "hybrid",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.yml", "docker-compose.ports.yml"],
      "composeProfiles": [],
      "envFiles": [".env"],
      "serviceEndpointMode": "published",
      "serviceEndpointGroups": ["runtime-stack"],
      "serviceEndpointDefaults": {
        "host": "127.0.0.1"
      },
      "daemon": {
        "socketPath": ".kirakira/runtime/daemon.sock",
        "eventStorePath": ".kirakira/runtime/events.sqlite",
        "browserGateway": {
          "enabled": true,
          "host": "127.0.0.1",
          "port": {
            "env": "KIRAKIRA_BROWSER_GATEWAY_PORT",
            "default": 17373
          },
          "path": "/runtime",
          "endpoint": {
            "env": "VITE_KIRAKIRA_GATEWAY_URL"
          }
        }
      },
      "presentation": {
        "web": {
          "host": "127.0.0.1",
          "port": {
            "env": "KIRAKIRA_WEB_PORT",
            "default": 5183
          },
          "url": {
            "env": "KIRAKIRA_WEB_URL"
          }
        },
        "desktop": {
          "host": "127.0.0.1",
          "port": {
            "env": "KIRAKIRA_DESKTOP_RENDERER_PORT",
            "default": 5174
          },
          "rendererUrl": {
            "env": ["KIRAKIRA_DESKTOP_RENDERER_URL", "KIRAKIRA_DESKTOP_DEV_URL"]
          }
        }
      },
      "workbench": {
        "defaultSurface": "web",
        "infraServiceGroups": ["runtime-stack"],
        "packages": {
          "daemon": {
            "package": "@kirakira/runtime-daemon",
            "script": "start"
          },
          "web": {
            "package": "@kirakira/web",
            "script": "dev"
          },
          "desktop-renderer": {
            "package": "@kirakira/desktop",
            "script": "dev:renderer"
          },
          "desktop-shell": {
            "package": "@kirakira/desktop",
            "script": "dev:electron"
          }
        },
        "surfaces": {
          "daemon": [
            {
              "package": "daemon",
              "mode": "foreground"
            }
          ],
          "web": [
            {
              "package": "daemon",
              "mode": "background",
              "skipWhen": "skipDaemon"
            },
            {
              "package": "web",
              "mode": "foreground",
              "waitFor": [
                {
                  "check": "daemon:browser-gateway",
                  "skipWhen": "skipDaemon"
                }
              ]
            }
          ],
          "desktop": [
            {
              "package": "daemon",
              "mode": "background",
              "skipWhen": "skipDaemon"
            },
            {
              "package": "desktop-renderer",
              "mode": "background"
            },
            {
              "package": "desktop-shell",
              "mode": "foreground",
              "waitFor": [
                {
                  "check": "daemon:socket",
                  "skipWhen": "skipDaemon"
                },
                {
                  "check": "daemon:browser-gateway",
                  "skipWhen": "skipDaemon"
                },
                "presentation:desktop"
              ]
            }
          ]
        },
        "smokeChecks": {
          "daemon": ["daemon:socket", "daemon:browser-gateway"],
          "web": ["daemon:browser-gateway", "presentation:web"],
          "desktop": ["daemon:socket", "daemon:browser-gateway", "presentation:desktop"]
        },
        "defaultSmokeGate": "presentation",
        "smokeGates": {
          "presentation": {
            "description": "Regular opt-in workbench presentation smoke gate covering browser gateway, web, and desktop renderer readiness.",
            "liveEnv": "KIRAKIRA_WORKBENCH_SMOKE_LIVE",
            "surfaces": ["web", "desktop"]
          }
        }
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "test-host": {
      "mode": "host",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeProject": "kirakira-agent-test",
      "composeFiles": ["docker-compose.test.yml"],
      "composeProfiles": [],
      "envFiles": [".env"],
      "serviceEndpointMode": "published",
      "serviceEndpointGroups": ["memory-stack"],
      "serviceEndpointDefaults": {
        "host": "127.0.0.1"
      },
      "serviceEndpoints": {
        "postgres": {
          "username": {
            "default": "kirakira_test"
          },
          "password": {
            "default": "kirakira_test"
          },
          "database": {
            "default": "kirakira_test"
          }
        }
      },
      "memory": {
        "persistenceGate": {
          "name": "memory-store:persistence",
          "liveEnv": "KIRAKIRA_MEMORY_PERSISTENCE_SMOKE_LIVE",
          "passedEnv": "KIRAKIRA_MEMORY_PERSISTENCE_SMOKE_PASSED",
          "checks": [
            "memory-store:checkpoint",
            "memory-store:retain-reflect"
          ],
          "unitTests": [
            "test/unit/runtime-daemon/memory-runtime-deps.test.ts",
            "test/unit/runtime/memory-test-host-env.test.ts"
          ],
          "liveTests": [
            "test/integration/memory/checkpoint-restore.test.ts",
            "test/integration/memory/retain-to-recall.test.ts"
          ]
        }
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "ci": {
      "mode": "hybrid",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeProject": "kirakira-agent-ci",
      "composeFiles": ["docker-compose.test.yml"],
      "composeProfiles": [],
      "envFiles": [],
      "services": {},
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    }
  }
}
