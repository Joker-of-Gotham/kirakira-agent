{
  "schemaVersion": 1,
  "defaultProfile": "container",
  "envBindings": {
    "services": {
      "kirakirad": "KIRAKIRA_PDP_ENDPOINT",
      "postgres": "DATABASE_URL",
      "redis": "REDIS_URL",
      "qdrant": "QDRANT_URL",
      "neo4j": "NEO4J_URI",
      "minio": "S3_ENDPOINT"
    },
    "values": {
      "daemon.socketPath": {
        "env": "KIRAKIRA_DAEMON_SOCKET",
        "resolve": "daemonSocketPath"
      },
      "daemon.eventStorePath": "KIRAKIRA_EVENT_STORE_PATH",
      "daemon.browserGateway.host": "KIRAKIRA_BROWSER_GATEWAY_HOST",
      "daemon.browserGateway.port": "KIRAKIRA_BROWSER_GATEWAY_PORT",
      "daemon.browserGateway.path": "KIRAKIRA_BROWSER_GATEWAY_PATH",
      "daemon.browserGateway.token": [
        "KIRAKIRA_BROWSER_GATEWAY_TOKEN",
        "VITE_KIRAKIRA_GATEWAY_TOKEN"
      ],
      "presentation.web.url": "KIRAKIRA_WEB_URL",
      "presentation.desktop.rendererUrl": [
        "KIRAKIRA_DESKTOP_RENDERER_URL",
        "KIRAKIRA_DESKTOP_DEV_URL"
      ]
    },
    "booleans": {
      "daemon.browserGateway.enabled": {
        "env": "KIRAKIRA_BROWSER_GATEWAY_ENABLED",
        "true": "1",
        "false": "0"
      }
    },
    "joined": {
      "daemon.browserGateway.allowedOrigins": {
        "env": "KIRAKIRA_BROWSER_GATEWAY_ALLOWED_ORIGINS",
        "separator": ","
      }
    },
    "computed": {
      "browserGatewayEndpoint": {
        "source": "daemon.browserGateway",
        "urlEnv": "VITE_KIRAKIRA_GATEWAY_URL",
        "modeEnv": "VITE_KIRAKIRA_RUNTIME_MODE",
        "mode": "gateway"
      }
    }
  },
  "serviceBindings": {
    "kirakirad": {
      "scheme": "tcp",
      "host": "kirakirad",
      "port": {
        "default": 17777
      }
    },
    "postgres": {
      "scheme": "postgres",
      "host": "postgres",
      "port": {
        "default": 5432
      },
      "username": {
        "env": "KIRAKIRA_POSTGRES_USER",
        "default": "kirakira"
      },
      "password": {
        "env": "KIRAKIRA_POSTGRES_PASSWORD",
        "default": "kirakira"
      },
      "database": {
        "env": "KIRAKIRA_POSTGRES_DB",
        "default": "kirakira"
      },
      "authInUrl": true
    },
    "redis": {
      "scheme": "redis",
      "host": "redis",
      "port": {
        "default": 6379
      }
    },
    "qdrant": {
      "scheme": "http",
      "host": "qdrant",
      "port": {
        "default": 6333
      }
    },
    "neo4j": {
      "scheme": "bolt",
      "host": "neo4j",
      "port": {
        "default": 7687
      },
      "username": {
        "env": "KIRAKIRA_NEO4J_USER",
        "default": "neo4j"
      },
      "password": {
        "env": "KIRAKIRA_NEO4J_PASSWORD",
        "default": "testpassword"
      }
    },
    "minio": {
      "scheme": "http",
      "host": "minio",
      "port": {
        "default": 9000
      },
      "username": {
        "env": ["KIRAKIRA_MINIO_ROOT_USER", "S3_ACCESS_KEY_ID"],
        "default": "minioadmin"
      },
      "password": {
        "env": ["KIRAKIRA_MINIO_ROOT_PASSWORD", "S3_SECRET_ACCESS_KEY"],
        "default": "minioadmin"
      }
    }
  },
  "profiles": {
    "container": {
      "mode": "container",
      "workspaceRoot": "/workspace",
      "appRoot": "/app",
      "composeFiles": ["docker-compose.yml"],
      "composeProfiles": ["cli"],
      "envFiles": [".env"],
      "serviceEndpoints": {
        "kirakirad": {},
        "postgres": {},
        "redis": {},
        "qdrant": {},
        "neo4j": {},
        "minio": {}
      },
      "mcp": {
        "workspaceRoot": "/workspace",
        "appRoot": "/app"
      },
      "containerStartup": {
        "runtimeImage": "kirakira-agent-runtime:local",
        "sourceHashLabel": "org.kirakira.source-hash",
        "sourceHashCachePath": ".kirakira/runtime-image.hash",
        "workspaceBuildCachePath": ".kirakira/workspace-build.hash",
        "buildService": "kirakira-agent",
        "runService": "kirakira-agent",
        "runtimeServices": ["postgres", "redis", "qdrant", "neo4j", "minio", "kirakirad"],
        "defaultCommand": ["chat"],
        "interactiveCommands": ["chat"],
        "runOptions": ["--rm", "--no-deps", "--pull", "never"],
        "hashRoots": [
          ".dockerignore",
          "Dockerfile",
          "configs/runtime/profiles.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          "turbo.json",
          "tsconfig.base.json",
          "vitest.config.ts",
          "pytest.ini",
          "packages",
          "scripts"
        ],
        "ignoredHashDirs": [".git", ".turbo", "coverage", "dist", "node_modules"],
        "ignoredHashFiles": ["scripts/kirakira.mjs"],
        "workspaceBuild": {
          "distEntry": "packages/cli/dist/index.js",
          "filter": "@kirakira/cli..."
        },
        "overlay": {
          "packagesRoot": "packages",
          "containerPackagesRoot": "/app/packages",
          "scripts": ["kirakira-container.mjs", "kirakira-common.mjs", "runtime-profile.mjs"],
          "containerScriptsRoot": "/app/scripts"
        }
      }
    },
    "host": {
      "mode": "host",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": [],
      "composeProfiles": [],
      "envFiles": [".env"],
      "serviceEndpointDefaults": {
        "host": "127.0.0.1"
      },
      "serviceEndpoints": {
        "kirakirad": {
          "port": {
            "env": "KIRAKIRA_KIRAKIRAD_PDP_PORT",
            "default": 17777
          }
        },
        "postgres": {
          "port": {
            "env": "KIRAKIRA_POSTGRES_PORT",
            "default": 5432
          }
        },
        "redis": {
          "port": {
            "env": "KIRAKIRA_REDIS_PORT",
            "default": 6379
          }
        },
        "qdrant": {
          "port": {
            "env": "KIRAKIRA_QDRANT_HTTP_PORT",
            "default": 6333
          }
        },
        "neo4j": {
          "port": {
            "env": "KIRAKIRA_NEO4J_BOLT_PORT",
            "default": 7687
          }
        },
        "minio": {
          "port": {
            "env": "KIRAKIRA_MINIO_API_PORT",
            "default": 9000
          }
        }
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "workbench-host": {
      "mode": "hybrid",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.yml", "docker-compose.ports.yml"],
      "composeProfiles": [],
      "envFiles": [".env"],
      "serviceEndpointDefaults": {
        "host": "127.0.0.1"
      },
      "serviceEndpoints": {
        "kirakirad": {
          "port": {
            "env": "KIRAKIRA_KIRAKIRAD_PDP_PORT",
            "default": 17777
          }
        },
        "postgres": {
          "port": {
            "env": "KIRAKIRA_POSTGRES_PORT",
            "default": 5432
          }
        },
        "redis": {
          "port": {
            "env": "KIRAKIRA_REDIS_PORT",
            "default": 6379
          }
        },
        "qdrant": {
          "port": {
            "env": "KIRAKIRA_QDRANT_HTTP_PORT",
            "default": 6333
          }
        },
        "neo4j": {
          "port": {
            "env": "KIRAKIRA_NEO4J_BOLT_PORT",
            "default": 7687
          }
        },
        "minio": {
          "port": {
            "env": "KIRAKIRA_MINIO_API_PORT",
            "default": 9000
          }
        }
      },
      "daemon": {
        "socketPath": ".kirakira/runtime/daemon.sock",
        "eventStorePath": ".kirakira/runtime/events.sqlite",
        "browserGateway": {
          "enabled": true,
          "host": "127.0.0.1",
          "port": {
            "env": "KIRAKIRA_BROWSER_GATEWAY_PORT",
            "default": 17373
          },
          "path": "/runtime",
          "endpoint": {
            "env": "VITE_KIRAKIRA_GATEWAY_URL"
          }
        }
      },
      "presentation": {
        "web": {
          "host": "127.0.0.1",
          "port": {
            "env": "KIRAKIRA_WEB_PORT",
            "default": 5183
          },
          "url": {
            "env": "KIRAKIRA_WEB_URL"
          }
        },
        "desktop": {
          "host": "127.0.0.1",
          "port": {
            "env": "KIRAKIRA_DESKTOP_RENDERER_PORT",
            "default": 5174
          },
          "rendererUrl": {
            "env": ["KIRAKIRA_DESKTOP_RENDERER_URL", "KIRAKIRA_DESKTOP_DEV_URL"]
          }
        }
      },
      "workbench": {
        "defaultSurface": "web",
        "infraServices": ["postgres", "redis", "qdrant", "neo4j", "minio", "kirakirad"],
        "packages": {
          "daemon": {
            "package": "@kirakira/runtime-daemon",
            "script": "start"
          },
          "web": {
            "package": "@kirakira/web",
            "script": "dev"
          },
          "desktop": {
            "package": "@kirakira/desktop",
            "script": "dev:renderer"
          }
        },
        "surfaces": {
          "daemon": [
            {
              "package": "daemon",
              "mode": "foreground"
            }
          ],
          "web": [
            {
              "package": "daemon",
              "mode": "background",
              "skipWhen": "skipDaemon"
            },
            {
              "package": "web",
              "mode": "foreground"
            }
          ],
          "desktop": [
            {
              "package": "daemon",
              "mode": "background",
              "skipWhen": "skipDaemon"
            },
            {
              "package": "desktop",
              "mode": "foreground"
            }
          ]
        }
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "test-host": {
      "mode": "host",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.test.yml"],
      "composeProfiles": [],
      "envFiles": [".env"],
      "serviceEndpointDefaults": {
        "host": "127.0.0.1"
      },
      "serviceEndpoints": {
        "postgres": {
          "port": {
            "env": "KIRAKIRA_POSTGRES_PORT",
            "default": 5432
          },
          "username": {
            "default": "kirakira_test"
          },
          "password": {
            "default": "kirakira_test"
          },
          "database": {
            "default": "kirakira_test"
          }
        },
        "redis": {
          "port": {
            "env": "KIRAKIRA_REDIS_PORT",
            "default": 6379
          }
        },
        "qdrant": {
          "port": {
            "env": "KIRAKIRA_QDRANT_HTTP_PORT",
            "default": 6333
          }
        },
        "neo4j": {
          "port": {
            "env": "KIRAKIRA_NEO4J_BOLT_PORT",
            "default": 7687
          }
        },
        "minio": {
          "port": {
            "env": "KIRAKIRA_MINIO_API_PORT",
            "default": 9000
          }
        }
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "ci": {
      "mode": "hybrid",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.test.yml"],
      "composeProfiles": [],
      "envFiles": [],
      "services": {},
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    }
  }
}
