        "redis": "redis://redis:6379",
        "qdrant": "http://qdrant:6333",
        "neo4j": "bolt://neo4j:7687",
        "minio": "http://minio:9000"
      },
      "mcp": {
        "workspaceRoot": "/workspace",
        "appRoot": "/app"
      }
    },
    "host": {
