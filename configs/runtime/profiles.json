{
  "schemaVersion": 1,
  "defaultProfile": "container",
  "envBindings": {
    "services": {
      "kirakirad": "KIRAKIRA_PDP_ENDPOINT",
      "postgres": "DATABASE_URL",
      "redis": "REDIS_URL",
      "qdrant": "QDRANT_URL",
      "neo4j": "NEO4J_URI",
      "minio": "S3_ENDPOINT"
    },
    "values": {
      "daemon.socketPath": {
        "env": "KIRAKIRA_DAEMON_SOCKET",
        "resolve": "daemonSocketPath"
      },
      "daemon.eventStorePath": "KIRAKIRA_EVENT_STORE_PATH",
      "daemon.browserGateway.host": "KIRAKIRA_BROWSER_GATEWAY_HOST",
      "daemon.browserGateway.port": "KIRAKIRA_BROWSER_GATEWAY_PORT",
      "daemon.browserGateway.path": "KIRAKIRA_BROWSER_GATEWAY_PATH",
      "daemon.browserGateway.token": [
        "KIRAKIRA_BROWSER_GATEWAY_TOKEN",
        "VITE_KIRAKIRA_GATEWAY_TOKEN"
      ],
      "presentation.web.url": "KIRAKIRA_WEB_URL",
      "presentation.desktop.rendererUrl": [
        "KIRAKIRA_DESKTOP_RENDERER_URL",
        "KIRAKIRA_DESKTOP_DEV_URL"
      ]
    },
    "booleans": {
      "daemon.browserGateway.enabled": {
        "env": "KIRAKIRA_BROWSER_GATEWAY_ENABLED",
        "true": "1",
        "false": "0"
      }
    },
    "joined": {
      "daemon.browserGateway.allowedOrigins": {
        "env": "KIRAKIRA_BROWSER_GATEWAY_ALLOWED_ORIGINS",
        "separator": ","
      }
    },
    "computed": {
      "browserGatewayEndpoint": {
        "source": "daemon.browserGateway",
        "urlEnv": "VITE_KIRAKIRA_GATEWAY_URL",
        "modeEnv": "VITE_KIRAKIRA_RUNTIME_MODE",
        "mode": "gateway"
      }
    }
  },
  "profiles": {
    "container": {
      "mode": "container",
      "workspaceRoot": "/workspace",
      "appRoot": "/app",
      "composeFiles": ["docker-compose.yml"],
      "composeProfiles": ["cli"],
      "envFiles": [".env"],
      "services": {
        "kirakirad": "tcp://kirakirad:17777",
        "postgres": "postgres://kirakira:kirakira@postgres:5432/kirakira",
        "redis": "redis://redis:6379",
        "qdrant": "http://qdrant:6333",
        "neo4j": "bolt://neo4j:7687",
        "minio": "http://minio:9000"
      },
      "mcp": {
        "workspaceRoot": "/workspace",
        "appRoot": "/app"
      }
    },
    "host": {
      "mode": "host",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": [],
      "composeProfiles": [],
      "envFiles": [".env"],
      "services": {
        "kirakirad": "tcp://127.0.0.1:17777",
        "postgres": "postgres://kirakira:kirakira@127.0.0.1:5432/kirakira",
        "redis": "redis://127.0.0.1:6379",
        "qdrant": "http://127.0.0.1:6333",
        "neo4j": "bolt://127.0.0.1:7687",
        "minio": "http://127.0.0.1:9000"
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "workbench-host": {
      "mode": "hybrid",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.yml", "docker-compose.ports.yml"],
      "composeProfiles": [],
      "envFiles": [".env"],
      "services": {
        "kirakirad": "tcp://127.0.0.1:17777",
        "postgres": "postgres://kirakira:kirakira@127.0.0.1:5432/kirakira",
        "redis": "redis://127.0.0.1:6379",
        "qdrant": "http://127.0.0.1:6333",
        "neo4j": "bolt://127.0.0.1:7687",
        "minio": "http://127.0.0.1:9000"
      },
      "daemon": {
        "socketPath": ".kirakira/runtime/daemon.sock",
        "eventStorePath": ".kirakira/runtime/events.sqlite",
        "browserGateway": {
          "enabled": true,
          "host": "127.0.0.1",
          "port": 17373,
          "path": "/runtime",
          "allowedOrigins": ["http://127.0.0.1:5183", "http://127.0.0.1:5174"]
        }
      },
      "presentation": {
        "web": {
          "url": "http://127.0.0.1:5183"
        },
        "desktop": {
          "rendererUrl": "http://127.0.0.1:5174"
        }
      },
      "workbench": {
        "defaultSurface": "web",
        "infraServices": ["postgres", "redis", "qdrant", "neo4j", "minio", "kirakirad"],
        "packages": {
          "daemon": {
            "package": "@kirakira/runtime-daemon",
            "script": "start"
          },
          "web": {
            "package": "@kirakira/web",
            "script": "dev"
          },
          "desktop": {
            "package": "@kirakira/desktop",
            "script": "dev:renderer"
          }
        },
        "surfaces": {
          "daemon": [
            {
              "package": "daemon",
              "mode": "foreground"
            }
          ],
          "web": [
            {
              "package": "daemon",
              "mode": "background",
              "skipWhen": "skipDaemon"
            },
            {
              "package": "web",
              "mode": "foreground"
            }
          ],
          "desktop": [
            {
              "package": "daemon",
              "mode": "background",
              "skipWhen": "skipDaemon"
            },
            {
              "package": "desktop",
              "mode": "foreground"
            }
          ]
        }
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "test-host": {
      "mode": "host",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.test.yml"],
      "composeProfiles": [],
      "envFiles": [".env"],
      "services": {
        "postgres": "postgres://kirakira:kirakira@127.0.0.1:55432/kirakira",
        "redis": "redis://127.0.0.1:56379",
        "qdrant": "http://127.0.0.1:56333",
        "neo4j": "bolt://127.0.0.1:57687",
        "minio": "http://127.0.0.1:59000"
      },
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    },
    "ci": {
      "mode": "hybrid",
      "workspaceRoot": ".",
      "appRoot": ".",
      "composeFiles": ["docker-compose.test.yml"],
      "composeProfiles": [],
      "envFiles": [],
      "services": {},
      "mcp": {
        "workspaceRoot": ".",
        "appRoot": "."
      }
    }
  }
}
