{
  "name": "kirakira-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kirakira-agent": "./packages/cli/bin/run.js"
  },
  "description": "Kirakira Agent Platform — modular orchestration, runtime, and tooling for AI agents",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "start": "node scripts/kirakira.mjs",
    "start:daemon": "node scripts/kirakira-workbench.mjs daemon",
    "start:web": "node scripts/kirakira-workbench.mjs web",
    "start:desktop": "node scripts/kirakira-workbench.mjs desktop",
    "dev:web": "pnpm --filter @kirakira/web dev",
    "dev:desktop": "pnpm --filter @kirakira/desktop dev:renderer",
    "llm:select": "node scripts/select-llm-provider.mjs",
    "runtime:profile": "node scripts/runtime-profile.mjs",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "clean": "turbo clean",
    "dev": "turbo dev"
  },
  "devDependencies": {
    "@kirakira/agent-runtime": "workspace:*",
    "@kirakira/audit-ledger": "workspace:*",
    "@kirakira/cli": "workspace:*",
    "@kirakira/compat": "workspace:*",
    "@kirakira/core": "workspace:*",
    "@kirakira/desktop": "workspace:*",
    "@kirakira/event-store": "workspace:*",
    "@kirakira/mcp-adapter": "workspace:*",
    "@kirakira/memory-core": "workspace:*",
    "@kirakira/memory-store": "workspace:*",
    "@kirakira/memory-vector": "workspace:*",
    "@kirakira/orchestrator-kernel": "workspace:*",
    "@kirakira/policy-engine": "workspace:*",
    "@kirakira/runtime-daemon": "workspace:*",
    "@kirakira/skill-runtime": "workspace:*",
    "@kirakira/web": "workspace:*",
    "@types/node": "22.15.0",
    "blake3": "^2.1.7",
    "postgres": "^3.4.0",
    "turbo": "^2.9.8",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
