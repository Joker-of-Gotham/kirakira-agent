# LLM Model Gateway
# Fill one or more provider keys, then run `pnpm llm:select`.
# The selector writes LLM_PROVIDER, LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL.
LLM_PROVIDER=auto
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
LLM_MIRROR_BASE_URLS=

# Kirakira Registry
KIRAKIRA_REGISTRY_URL=https://npm.company.internal
KIRAKIRA_REGISTRY_TOKEN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kirakira-agent-cli

# MCP
GITHUB_TOKEN=
RESEARCH_MCP_TOKEN=
