# LLM Model Gateway
# Fill one or more provider keys, then run `pnpm llm:select`.
# The selector writes LLM_PROVIDER, LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL.
LLM_PROVIDER=auto
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
LLM_MIRROR_BASE_URLS=

# Runtime profiles
KIRAKIRA_RUNTIME_PROFILE=container
KIRAKIRA_WORKBENCH_PROFILE=workbench-host
KIRAKIRA_WORKSPACE_ROOT=/workspace
KIRAKIRA_APP_ROOT=/app
KIRAKIRA_MCP_WORKSPACE_ROOT=/workspace
KIRAKIRA_MCP_APP_ROOT=/app
KIRAKIRA_PDP_ENDPOINT=
KIRAKIRA_POLICY_BUNDLE=/workspace/policies
KIRAKIRA_KIRAKIRAD_PDP_PORT=17777
KIRAKIRA_KIRAKIRAD_HEALTH_PORT=8181
KIRAKIRA_POSTGRES_USER=kirakira
KIRAKIRA_POSTGRES_PASSWORD=kirakira
KIRAKIRA_POSTGRES_DB=kirakira
KIRAKIRA_POSTGRES_PORT=5432
DATABASE_URL=
KIRAKIRA_REDIS_PORT=6379
REDIS_URL=
KIRAKIRA_QDRANT_HTTP_PORT=6333
KIRAKIRA_QDRANT_GRPC_PORT=6334
QDRANT_URL=
KIRAKIRA_NEO4J_AUTH=
KIRAKIRA_NEO4J_USER=neo4j
KIRAKIRA_NEO4J_PASSWORD=testpassword
KIRAKIRA_NEO4J_BOLT_PORT=7687
KIRAKIRA_NEO4J_HTTP_PORT=7474
NEO4J_URI=
KIRAKIRA_MINIO_ROOT_USER=minioadmin
KIRAKIRA_MINIO_ROOT_PASSWORD=minioadmin
KIRAKIRA_MINIO_API_PORT=9000
KIRAKIRA_MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Presentation surfaces
KIRAKIRA_WEB_PORT=5183
KIRAKIRA_WEB_URL=
KIRAKIRA_DESKTOP_RENDERER_PORT=5174
KIRAKIRA_DESKTOP_RENDERER_URL=
KIRAKIRA_API_BASE_URL=http://127.0.0.1:17777
KIRAKIRA_BROWSER_GATEWAY_ENABLED=1
KIRAKIRA_BROWSER_GATEWAY_HOST=127.0.0.1
KIRAKIRA_BROWSER_GATEWAY_PORT=17373
KIRAKIRA_BROWSER_GATEWAY_PATH=/runtime
KIRAKIRA_BROWSER_GATEWAY_ALLOWED_ORIGINS=
VITE_KIRAKIRA_RUNTIME_MODE=gateway
VITE_KIRAKIRA_GATEWAY_URL=

# Kirakira Registry
KIRAKIRA_REGISTRY_URL=https://npm.company.internal
KIRAKIRA_REGISTRY_TOKEN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kirakira-agent-cli

# MCP
# Either GitHub token name works; the CLI mirrors them at startup.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
RESEARCH_MCP_TOKEN=
