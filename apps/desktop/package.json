{
  "name": "@kirakira/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kirakira Agent desktop workbench",
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "vite build --config vite.renderer.config.ts && tsc -p tsconfig.main.json",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@kirakira/frontend-app": "workspace:*",
    "@kirakira/frontend-core": "workspace:*",
    "@kirakira/runtime-contracts": "workspace:*",
    "@kirakira/runtime-daemon": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "vite": "^7.3.2"
  }
}
