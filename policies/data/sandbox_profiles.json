{
  "kirakira": {
    "config": {
      "sandbox_profiles": {
        "plan-only": {
          "filesystem": {"root_mode": "none", "read_only_mounts": [], "read_write_mounts": [], "deny_paths": ["**"]},
          "network": {"mode": "off", "domains": []},
          "process": {"seccomp": "default-deny", "max_cpu_seconds": 10, "max_memory_mb": 256, "allow_exec": []},
          "secrets": {"exposed": []},
          "copyout": {"require_post_review": false}
        },
        "read-only": {
          "filesystem": {"root_mode": "workspace", "read_only_mounts": ["$WORKSPACE"], "read_write_mounts": ["/tmp"], "deny_paths": ["**/.ssh/**", "**/.aws/**"]},
          "network": {"mode": "off", "domains": []},
          "process": {"seccomp": "default-deny", "max_cpu_seconds": 60, "max_memory_mb": 512, "allow_exec": ["cat", "grep", "find", "ls", "head", "tail", "wc", "sort", "uniq", "git"]},
          "secrets": {"exposed": []},
          "copyout": {"require_post_review": false}
        },
        "workspace-write": {
          "filesystem": {"root_mode": "workspace", "read_only_mounts": [], "read_write_mounts": ["$WORKSPACE", "/tmp"], "deny_paths": ["**/.ssh/**", "**/.aws/**"]},
          "network": {"mode": "off", "domains": []},
          "process": {"seccomp": "permissive", "max_cpu_seconds": 300, "max_memory_mb": 2048, "allow_exec": ["*"]},
          "secrets": {"exposed": []},
          "copyout": {"require_post_review": false}
        },
        "workspace-write-net": {
          "filesystem": {"root_mode": "workspace", "read_only_mounts": [], "read_write_mounts": ["$WORKSPACE", "/tmp"], "deny_paths": ["**/.ssh/**", "**/.aws/**"]},
          "network": {"mode": "allowlist", "domains": ["*.npmjs.org", "registry.npmjs.org", "pypi.org", "files.pythonhosted.org"]},
          "process": {"seccomp": "permissive", "max_cpu_seconds": 600, "max_memory_mb": 4096, "allow_exec": ["*"]},
          "secrets": {"exposed": ["NPM_TOKEN"]},
          "copyout": {"require_post_review": false}
        },
        "mcp-read": {
          "filesystem": {"root_mode": "none", "read_only_mounts": [], "read_write_mounts": [], "deny_paths": ["**"]},
          "network": {"mode": "per-server", "domains": []},
          "process": {"seccomp": "default-deny", "max_cpu_seconds": 30, "max_memory_mb": 512, "allow_exec": []},
          "secrets": {"exposed": []},
          "copyout": {"require_post_review": false}
        },
        "mcp-write": {
          "filesystem": {"root_mode": "workspace", "read_only_mounts": [], "read_write_mounts": ["$WORKSPACE"], "deny_paths": ["**/.ssh/**", "**/.aws/**", "**/.gnupg/**"]},
          "network": {"mode": "per-server", "domains": []},
          "process": {"seccomp": "default-deny", "max_cpu_seconds": 60, "max_memory_mb": 1024, "allow_exec": []},
          "secrets": {"exposed": []},
          "copyout": {"require_post_review": true}
        },
        "microvm-highrisk": {
          "filesystem": {"root_mode": "temp", "read_only_mounts": [], "read_write_mounts": ["/tmp/kirakira-sandbox"], "deny_paths": ["**"]},
          "network": {"mode": "off", "domains": []},
          "process": {"seccomp": "default-deny", "max_cpu_seconds": 120, "max_memory_mb": 2048, "allow_exec": []},
          "secrets": {"exposed": []},
          "copyout": {"require_post_review": true}
        }
      }
    }
  }
}
