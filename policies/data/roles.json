        },
        "org_admin": {
          "permissions": ["read", "write", "execute", "vcs_push", "secret_read", "audit_export", "policy_manage", "user_manage"],
          "sandbox_profiles": ["plan-only", "read-only", "workspace-write", "workspace-write-net", "mcp-read", "mcp-write", "microvm-highrisk"]
